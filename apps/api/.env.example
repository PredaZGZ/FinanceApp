# Prisma uses this URL for introspection and migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# The API currently supports the legacy DB_* variables too.
PORT=3001
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=financeapp

# Generate independent random 32-byte values for every environment.
JWT_SECRET=replace-with-64-random-hex-characters
PEPPER=replace-with-64-random-hex-characters
ENCRYPTION_KEY=replace-with-64-random-hex-characters
